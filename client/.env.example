# Public API base URL used by the Vite client
VITE_API_URL=http://localhost:5000/api

# Google Identity Services OAuth Web Client ID
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Optional MapLibre style URL. The client falls back to OpenFreeMap when omitted.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Optional exported Spline scene URL. A lightweight fallback scene is used when omitted.
VITE_SPLINE_SCENE_URL=

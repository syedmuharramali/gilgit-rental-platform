NODE_ENV=development
PORT=5000

CLIENT_URL=http://localhost:5173

# Optional comma-separated additional frontends
CLIENT_URLS=

MONGODB_URI=
DB_NAME=gilgit_rental_platform

JWT_SECRET=
JWT_EXPIRES_IN=7d

# Sign-in cookie (httpOnly). Leave both unset for local development.
# If the website and the API are on different sites in production
# (e.g. the site on *.vercel.app and the API on *.onrender.com), set
# COOKIE_SAME_SITE=none — the cookie is then always Secure (HTTPS only).
COOKIE_SAME_SITE=lax
COOKIE_SECURE=

# Google Identity Services OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID=

# Outgoing email (Gmail SMTP with an app password)
# Create the app password at https://myaccount.google.com/apppasswords
# Without these the confirmation link is printed to the server console in development.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=Gilgit Rental Platform

APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_BUCKET_ID=
# "production" on the server host (secure cookies, proxy handling and
# error messages depend on it). The host usually sets PORT itself.
NODE_ENV=development
PORT=5000

# The website address, no trailing slash. Production example:
# CLIENT_URL=https://fyp.syedmuharramali.com
CLIENT_URL=http://localhost:5173

# Optional comma-separated additional frontends
CLIENT_URLS=

MONGODB_URI=
DB_NAME=gilgit_rental_platform

JWT_SECRET=

# Sign-in cookie (httpOnly). Keep "lax" when the website and the API share
# a domain (e.g. fyp.syedmuharramali.com + api-fyp.syedmuharramali.com);
# COOKIE_SECURE can stay empty (it's on automatically in production).
# Only if they are on unrelated domains (e.g. *.vercel.app + *.up.railway.app)
# set COOKIE_SAME_SITE=none; Safari may still block that cookie.
COOKIE_SAME_SITE=lax
COOKIE_SECURE=

# Google Identity Services OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID=

# Outgoing email. Option 1 (use this on Railway: its Free/Hobby plans block
# SMTP): Resend, with MAIL_FROM_ADDRESS on a domain verified in Resend.
RESEND_API_KEY=
MAIL_FROM_ADDRESS=

# Option 2: Gmail SMTP with an app password (fine for local development).
# Create the app password at https://myaccount.google.com/apppasswords
# Without any email settings the confirmation link is printed to the server
# console in development.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=Gilgit Rental Platform

APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_BUCKET_ID=